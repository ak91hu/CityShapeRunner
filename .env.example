# ---- LLM providers (at least one needed for AI agents; leave blank to use rule-based fallback) ----
# OpenCode (recommended free profile): get a key at https://opencode.ai/auth.
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
# ``cli`` starts a loopback-only OpenCode server and permits cost-zero models.
# Use ``api`` only for paid Console models that accept direct API calls.
OPENCODE_TRANSPORT=cli
OPENCODE_SERVER_URL=http://127.0.0.1:4097
# Used only by the paid/direct API transport. The free CLI transport embeds the
# schema in its prompt and leaves this unset.
OPENCODE_STRUCTURED_MODEL=
# Free OpenCode model used by the production CLI transport.
LLM_MODEL=muse-spark-1.3-contributor-free
# Optional provider-specific model ids. They keep fallback/visual-review
# providers from receiving another provider's incompatible model id.
OPENCODE_MODEL=muse-spark-1.3-contributor-free
OPENAI_MODEL=
ANTHROPIC_MODEL=
OLLAMA_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Set only when Ollama is running and reachable from this process/container.
OLLAMA_BASE_URL=
# Active provider: opencode | openai | anthropic | ollama | auto
LLM_PROVIDER=opencode
LLM_USAGE_MODE=essential
# Comma-separated fallback order, e.g. "opencode,anthropic,openai,ollama"
LLM_FALLBACK=opencode
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# ---- OpenRouteService (required for selectable routes and GPX/TCX output). ----
# Without a working key, /generate and /edit-route fail closed with HTTP 503.
# Get a key at https://openrouteservice.org
ORS_API_KEY=
ORS_BASE_URL=https://api.heigit.org/openrouteservice
ORS_SNAP_RADIUS_M=120
# Keep false for GPS-art cusps and lettering, which may require U-turns.
ORS_CONTINUE_STRAIGHT=false
ORS_PREFERENCE=shortest

# ---- Nominatim geocoding (free, no key required, set a contact email for polite usage) ----
NOMINATIM_EMAIL=you@example.com
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# ---- OpenStreetMap context for the optional night-run check and sightseeing list ----
# Best effort: an outage degrades those layers to "unavailable" without blocking generation.
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
# The public mirror rejects default library user agents with HTTP 406.
OVERPASS_USER_AGENT=GPSArtWizard/1.0

# ---- Workflow ----
MAX_REFINEMENT_ITERATIONS=8
VALIDATION_SCORE_THRESHOLD=0.72
DEFAULT_SPORT=run            # run | bike
DEFAULT_CITY=Budapest
DEFAULT_RUN_DISTANCE_KM=8
DEFAULT_BIKE_DISTANCE_KM=20
PREFLIGHT_ENABLED=true
PREFLIGHT_MAX_PLACEMENTS=180
PREFLIGHT_SHORTLIST=7
PREFLIGHT_GUIDE_POINTS=18
# Concurrent candidate route measurements during recovery/suggestion/fallback
# searches. Higher values lower latency but consume API quota faster.
MEASUREMENT_WORKERS=3
# The hosted free model is text-only. Geometry checks replace paid image review.
AI_SHAPE_VERIFIER_ENABLED=false
AI_SHAPE_MIN_SEMANTIC_SCORE=0.68
AI_SHAPE_MAX_CANDIDATES=1
# Final street images: one provider attempt, up to three candidates, cached.
AI_ROUTE_VERIFIER_ENABLED=false
AI_ROUTE_VERIFIER_CANDIDATES=3
# Three adaptive Snap batches share the existing total placement budget.
PREFLIGHT_ADAPTIVE=true
# Extra measured neighbourhood candidates after the main search (0 disables, max 4).
SHAPE_POLISH_CANDIDATES=4
# Local graph proposes shape-aware guides; Directions validates the route.
SHAPE_GRAPH_ENABLED=true
SHAPE_GRAPH_SECONDS=2
# Optional Overpass JSON snapshot with an elements array for repeatable search.
SHAPE_GRAPH_SNAPSHOT=
# Per-generation runtime guardrails. -1 removes the call-count quota for the
# configured free model; the wall-clock deadline and provider timeouts remain.
WORKFLOW_MAX_DURATION_SECONDS=175
WORKFLOW_MAX_LLM_CALLS=-1
WORKFLOW_MAX_TRACE_EVENTS=256

# ---- API server ----
API_HOST=127.0.0.1
API_PORT=8000
WEB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Runtime identity and observability ----
# Hosting platforms may supply PORT automatically; it takes precedence over
# API_PORT. Set APP_REVISION to a release/commit identifier when desired.
APP_ENV=local
SERVICE_NAME=gps-art-wizard
APP_REVISION=

# Optional. Leave blank for stateless in-memory GPX/TCX responses.
# Set only when the server should persist selected exports to this directory.
EXPORT_DIR=
# Anonymous map screenshot gallery. Keep the API secret server-side.
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
# Structured request-correlated JSON logs. Local file output rotates
# automatically. Set LOG_FILE to an empty value on Northflank; its native Loki
# log sink forwards the JSON console stream to Grafana Cloud.
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/gps-art-wizard.log
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=5
