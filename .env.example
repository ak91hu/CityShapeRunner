# ---- LLM providers (at least one needed for AI agents; leave blank to use rule-based fallback) ----
# OpenCode Zen (recommended): get a key at https://opencode.ai/auth, reuse it from opencode.
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
# Zen model id reachable via /v1/chat/completions (glm-5.2, kimi-k2.6, deepseek-v4-flash, ...)
LLM_MODEL=glm-5.2
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Set only when Ollama is running and reachable from this process/container.
OLLAMA_BASE_URL=
# Active provider: opencode | openai | anthropic | ollama | auto
LLM_PROVIDER=opencode
# Comma-separated fallback order, e.g. "opencode,anthropic,openai,ollama"
LLM_FALLBACK=opencode,anthropic,openai,ollama
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# ---- OpenRouteService (snap-to-road + routing). Get a free key at https://openrouteservice.org ----
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org
ORS_SNAP_RADIUS_M=120
# Keep false for GPS-art cusps and lettering, which may require U-turns.
ORS_CONTINUE_STRAIGHT=false
ORS_PREFERENCE=shortest

# ---- Nominatim geocoding (free, no key required, set a contact email for polite usage) ----
NOMINATIM_EMAIL=you@example.com
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# ---- Workflow ----
MAX_REFINEMENT_ITERATIONS=8
VALIDATION_SCORE_THRESHOLD=0.72
DEFAULT_SPORT=run            # run | bike
DEFAULT_CITY=Budapest
DEFAULT_RUN_DISTANCE_KM=8
DEFAULT_BIKE_DISTANCE_KM=20
PREFLIGHT_ENABLED=true
PREFLIGHT_MAX_PLACEMENTS=180
PREFLIGHT_SHORTLIST=7
PREFLIGHT_GUIDE_POINTS=18

# ---- API server ----
API_HOST=127.0.0.1
API_PORT=8000
WEB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Runtime identity and observability ----
# Hosting platforms may supply PORT automatically; it takes precedence over
# API_PORT. Set APP_REVISION to a release/commit identifier when desired.
APP_ENV=local
SERVICE_NAME=gps-art-wizard
APP_REVISION=

# Optional. Leave blank for stateless in-memory GPX/TCX responses.
# Set only when the server should persist selected exports to this directory.
EXPORT_DIR=
# Anonymous map screenshot gallery. Keep the API secret server-side.
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
# Structured request-correlated JSON logs. Local file output rotates
# automatically. Set LOG_FILE to an empty value on Northflank; its native Loki
# log sink forwards the JSON console stream to Grafana Cloud.
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/gps-art-wizard.log
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=5
