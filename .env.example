# ---- Database (optional: unset = in-memory store, app still works) ----
CSR_DATABASE_URL=
CSR_REDIS_URL=

# ---- Web/API URLs ----
CSR_PUBLIC_WEB_URL=http://localhost:3000
CSR_API_BASE_URL=http://localhost:8000

# ---- External map/routing providers ----
CSR_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
CSR_PHOTON_BASE_URL=https://photon.komoot.io
CSR_OVERPASS_BASE_URL=https://overpass-api.de
CSR_OSRM_BASE_URL=http://router.project-osrm.org

# ---- OpenRouteService (snap-to-road + routing) ----
# Get a free key at https://openrouteservice.org
CSR_ORS_API_KEY=your_ors_api_key_here
CSR_ORS_BASE_URL=https://api.openrouteservice.org

# ---- AI assistance (OpenCode Zen API for shape matching retry) ----
# Used for AI-assisted improvement when deterministic confidence is too low
CSR_ZEN_API_KEY=your_zen_api_key_here
CSR_ZEN_BASE_URL=https://api.opencode.ai

# ---- Map tiles (frontend) ----
# Exposed to the browser via NEXT_PUBLIC_ prefix
# Default: CARTO Voyager (free, no key needed). Override with ORS or other provider.
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png
NEXT_PUBLIC_MAP_TILE_ATTR=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &copy; <a href="https://carto.com/attributions">CARTO</a>
NEXT_PUBLIC_MAP_TILE_SUBDOMAINS=abcd
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---- Security ----
CSR_JWT_SECRET=change-me

# ---- Feature flags ----
CSR_ENABLE_CONNECT_THE_DOTS_EXPORT=true
CSR_ENABLE_ELEVATION=false
CSR_ENABLE_USER_ACCOUNTS=false
CSR_ENABLE_AI_RETRY=true

# ---- Rate limits ----
CSR_ANON_GENERATION_PER_DAY=10000
CSR_ANON_GPX_PER_DAY=10000
CSR_CITY_SEARCH_PER_MIN=60

# ---- Algorithm tuning ----
CSR_WORKER_TIMEOUT_SECONDS=120
CSR_MAX_CANDIDATE_TRANSFORMATIONS=2000
CSR_MAX_ROUTE_REPAIRS=200
CSR_MAX_RETURNED_CANDIDATES=12
CSR_MIN_CONFIDENCE=0.65
CSR_MAX_AI_RETRY_ROUNDS=2

# ---- Mapbox Integration ----
CSR_MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here
