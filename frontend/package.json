{
  "name": "paceasso-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "npm run test:unit && npm run build",
    "test:unit": "node --test unit/*.test.js",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:smoke": "playwright test accessibility-functional.spec.js usability-functional.spec.js generation-experience.spec.js",
    "test:smoke:cross-browser": "playwright test --config=playwright.cross-browser.config.js accessibility-functional.spec.js usability-functional.spec.js generation-experience.spec.js",
    "test:cross-browser": "playwright test --config=playwright.cross-browser.config.js",
    "test:prod-gallery": "playwright test --config=playwright.prod.config.js"
  },
  "dependencies": {
    "leaflet-rotate-map": "0.3.2",
    "maplibre-gl": "^6.11.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@vitejs/plugin-react": "6.0.4",
    "playwright": "1.62.1",
    "vite": "8.1.5"
  }
}
